# === Telegram ===
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# === Цены ===
# Цена одной звезды в рублях
STAR_PRICE_RUB=1.5
MIN_STARS=50
MAX_STARS=100000

# === Platega (личный кабинет -> Настройки) ===
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
# Куда вернуть клиента после оплаты (обычно ссылка на бота)
PLATEGA_RETURN_URL=https://t.me/starify_tg_bot
# Коды методов Platega: 2 = СБП (QR), 13 = Криптовалюта
PLATEGA_METHOD_SBP=2
PLATEGA_METHOD_CRYPTO=13

# === Доставка ===
# Сколько секунд ждать реакции админа, прежде чем бот отправит звёзды сам
ADMIN_TIMEOUT_SEC=300

# === Fragment (автодоставка) ===
# 1 = включить автодоставку. Используй ОТДЕЛЬНЫЙ кошелёк с небольшим балансом!
FRAGMENT_ENABLED=0
# Сид-фраза кошелька-плательщика (12/24 слова)
FRAGMENT_SEED=
# Ключ TON API (tonconsole.com или toncenter.com)
FRAGMENT_API_KEY=
FRAGMENT_API_PROVIDER=tonapi
FRAGMENT_WALLET_VERSION=V5R1
# Куки fragment.com в формате JSON: {"stel_ssid":"...","stel_dt":"...","stel_token":"...","stel_ton_token":"..."}
FRAGMENT_COOKIES=
